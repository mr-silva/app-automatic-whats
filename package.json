{
  "name": "app-automatic-whats",
  "version": "0.0.3",
  "description": "Aplicativo de mensagens automáticas em lote via whatsapp.",
  "author": "Maicon R. Silva <maiconrods@gmail.com>",
  "private": true,
  "imports": {
      "#framework": "./resources/framework/src/index.ts",
      "#domain": "./src/Domain/index.ts",
      "#application": "./src/Application/index.ts",
      "#factory": "./src/Factory/index.ts"
  },
  "scripts": {
    "start": "docker-compose up -d",
    "stop": "docker-compose stop",
    "logs:api": "docker logs app-automatic-whats-app-1 -f",
    "logs:worker": "docker logs app-automatic-whats-worker-1 -f",
    "build": "tsc",
    "api": "node dist/src/Application/api.js",
    "worker": "node dist/src/Application/eventWorker.js",
    "dev:api": "tsnd --transpile-only --respawn --inspect=0.0.0.0:9229 src/Adapter/Http/api.ts",
    "dev:worker": "tsnd --transpile-only --respawn --inspect=0.0.0.0:9229 src/Adapter/Http/eventWorker.ts"
  },
  "dependencies": {
    "axios": "^1.1.3",
    "bullmq": "^3.4.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "joi": "^17.6.0",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.29.4",
    "mongodb": "4.3.1",
    "mongoose": "^6.2.9",
    "redis": "^4.6.4",
    "request": "^2.88.2",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^28.1.6",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^18.6.5",
    "@types/redis": "^2.8.31",
    "prettier": "^2.7.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "4.7.4"
  }
}
